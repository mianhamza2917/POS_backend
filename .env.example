# =========================================
# POS Backend - Environment Variables
# =========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/pos_system

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# Email Configuration (for forgot/reset password)
# For Gmail, use an App Password (not your regular password)
# See: https://support.google.com/mail/?p=BadCredentials
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=noreply@pos.com

# CORS Configuration
CORS_ORIGIN=*

# Optional: Branch Configuration
DEFAULT_BRANCH_ID=main

